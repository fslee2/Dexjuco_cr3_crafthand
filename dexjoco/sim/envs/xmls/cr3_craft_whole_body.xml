<?xml version='1.0' encoding='utf-8'?>
<mujoco model="cr3_craft_whole_body">
  <compiler angle="radian"/>

  <!-- ========================= DEFAULTS ========================= -->
  <default>
    <joint armature="0.01" damping="0.1"/>
  </default>

  <!-- ========================= ASSETS ========================= -->
  <asset>
    <!-- CR3 arm meshes -->
    <mesh name="base_link" file="cr3_craft/models/meshes/base_link.STL"/>
    <mesh name="J1" file="cr3_craft/models/meshes/J1.STL"/>
    <mesh name="J2" file="cr3_craft/models/meshes/J2.STL"/>
    <mesh name="J3" file="cr3_craft/models/meshes/J3.STL"/>
    <mesh name="J4" file="cr3_craft/models/meshes/J4.STL"/>
    <mesh name="J5" file="cr3_craft/models/meshes/J5.STL"/>
    <mesh name="J6" file="cr3_craft/models/meshes/J6.STL"/>
    <!-- CRAFT hand meshes -->
    <mesh name="base" file="cr3_craft/models/meshes/base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="index1" file="cr3_craft/models/meshes/index1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="index2" file="cr3_craft/models/meshes/index2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="index3" file="cr3_craft/models/meshes/index3.stl" scale="0.001 0.001 0.001"/>
    <mesh name="index4" file="cr3_craft/models/meshes/index4.stl" scale="0.001 0.001 0.001"/>
    <mesh name="middle1" file="cr3_craft/models/meshes/middle1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="middle2" file="cr3_craft/models/meshes/middle2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="middle3" file="cr3_craft/models/meshes/middle3.stl" scale="0.001 0.001 0.001"/>
    <mesh name="middle4" file="cr3_craft/models/meshes/middle4.stl" scale="0.001 0.001 0.001"/>
    <mesh name="ring1" file="cr3_craft/models/meshes/ring1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="ring2" file="cr3_craft/models/meshes/ring2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="ring3" file="cr3_craft/models/meshes/ring3.stl" scale="0.001 0.001 0.001"/>
    <mesh name="ring4" file="cr3_craft/models/meshes/ring4.stl" scale="0.001 0.001 0.001"/>
    <mesh name="pinky1" file="cr3_craft/models/meshes/pinky1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="pinky2" file="cr3_craft/models/meshes/pinky2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="pinky3" file="cr3_craft/models/meshes/pinky3.stl" scale="0.001 0.001 0.001"/>
    <mesh name="pinky4" file="cr3_craft/models/meshes/pinky4.stl" scale="0.001 0.001 0.001"/>
    <mesh name="thumbmcp" file="cr3_craft/models/meshes/ThumbMCP.stl" scale="0.001 0.001 0.001"/>
    <mesh name="thumb2" file="cr3_craft/models/meshes/thumb2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="thumb3" file="cr3_craft/models/meshes/thumb3.stl" scale="0.001 0.001 0.001"/>
    <mesh name="thumb4" file="cr3_craft/models/meshes/thumb4.stl" scale="0.001 0.001 0.001"/>
    <!-- Pedestal mesh (reuse Panda rethink_mount) -->
    <mesh name="pedestal" file="rethink_mount/pedestal.stl"/>
  </asset>

  <!-- ========================= WORLD BODY ========================= -->
  <worldbody>
    <!-- Root: same world position as Panda base (-0.8, 0, 0.924).
         Pedestal geoms sit at root origin; CR3 robot offset by -24mm in Z
         to match the shell-verified mount point (world z=0.9). -->
    <body name="cr3_craft_base" pos="-0.8 0 0.924">
      <!-- Pedestal visual (same mesh Panda uses, visual only) -->
      <geom name="cr3_pedestal_vis" type="mesh" mesh="pedestal"
            rgba="0.22 0.22 0.22 1" contype="0" conaffinity="0" group="1"/>
      <!-- Pedestal collision cylinder (decorative only) -->
      <geom name="cr3_pedestal_col" type="cylinder" size="0.18 0.31"
            pos="-0.02 0 -0.29" rgba="0.2 0.2 0.2 1" group="3"
            contype="0" conaffinity="0"/>

      <!-- CR3 mount: relative offset reproduces shell's cr3_mount at world z=0.9 -->
      <body name="cr3_mount" pos="0 0 -0.024">
        <include file="cr3_craft/models/cr3_robot_hand_body.xml"/>
      </body>
    </body>
  </worldbody>

  <!-- ========================= ACTUATORS ========================= -->
  <!-- Shell config: motor for arm (torque control), position for hand -->
  <actuator>
    <motor name="arm_joint1" joint="joint1" ctrllimited="true" ctrlrange="-120 120" forcelimited="true" forcerange="-120 120"/>
    <motor name="arm_joint2" joint="joint2" ctrllimited="true" ctrlrange="-120 120" forcelimited="true" forcerange="-120 120"/>
    <motor name="arm_joint3" joint="joint3" ctrllimited="true" ctrlrange="-120 120" forcelimited="true" forcerange="-120 120"/>
    <motor name="arm_joint4" joint="joint4" ctrllimited="true" ctrlrange="-60 60" forcelimited="true" forcerange="-60 60"/>
    <motor name="arm_joint5" joint="joint5" ctrllimited="true" ctrlrange="-60 60" forcelimited="true" forcerange="-60 60"/>
    <motor name="arm_joint6" joint="joint6" ctrllimited="true" ctrlrange="-60 60" forcelimited="true" forcerange="-60 60"/>
    <position name="h_index_1" joint="index_1" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_index_2" joint="index_2" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_index_3" joint="index_3" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_index_4" joint="index_4" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_middle_1" joint="middle_1" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_middle_2" joint="middle_2" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_middle_3" joint="middle_3" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_middle_4" joint="middle_4" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_ring_1" joint="ring_1" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_ring_2" joint="ring_2" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_ring_3" joint="ring_3" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_ring_4" joint="ring_4" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_pinky_1" joint="pinky_1" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_pinky_2" joint="pinky_2" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_pinky_3" joint="pinky_3" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_pinky_4" joint="pinky_4" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_thumb_mcp" joint="thumb_mcp" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_thumb_2" joint="thumb_2" kp="80" kv="12" forcerange="-5 5" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_thumb_3" joint="thumb_3" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
    <position name="h_thumb_4" joint="thumb_4" kp="50" kv="8" forcerange="-3 3" ctrllimited="true" ctrlrange="-3 3"/>
  </actuator>

  <!-- ========================= CRAFT DISTAL COUPLING ========================= -->
  <equality>
    <joint joint1="index_3" joint2="index_4" polycoef="0 1 0 0 0"/>
    <joint joint1="middle_3" joint2="middle_4" polycoef="0 1 0 0 0"/>
    <joint joint1="ring_3" joint2="ring_4" polycoef="0 1 0 0 0"/>
    <joint joint1="pinky_3" joint2="pinky_4" polycoef="0 1 0 0 0"/>
    <joint joint1="thumb_3" joint2="thumb_4" polycoef="0 1 0 0 0"/>
  </equality>

  <!-- ========================= CRAFT SELF-COLLISION EXCLUDES ========================= -->
  <contact>
    <exclude body1="base" body2="index1"/>
    <exclude body1="base" body2="index2"/>
    <exclude body1="index1" body2="index2"/>
    <exclude body1="index2" body2="index3"/>
    <exclude body1="index3" body2="index4"/>
    <exclude body1="base" body2="middle1"/>
    <exclude body1="base" body2="middle2"/>
    <exclude body1="middle1" body2="middle2"/>
    <exclude body1="middle2" body2="middle3"/>
    <exclude body1="middle3" body2="middle4"/>
    <exclude body1="base" body2="ring1"/>
    <exclude body1="base" body2="ring2"/>
    <exclude body1="ring1" body2="ring2"/>
    <exclude body1="ring2" body2="ring3"/>
    <exclude body1="ring3" body2="ring4"/>
    <exclude body1="base" body2="pinky1"/>
    <exclude body1="base" body2="pinky2"/>
    <exclude body1="pinky1" body2="pinky2"/>
    <exclude body1="pinky2" body2="pinky3"/>
    <exclude body1="pinky3" body2="pinky4"/>
    <exclude body1="base" body2="thumbmcp"/>
    <exclude body1="base" body2="thumb2"/>
    <exclude body1="thumbmcp" body2="thumb2"/>
    <exclude body1="thumb2" body2="thumb3"/>
    <exclude body1="thumb3" body2="thumb4"/>
  </contact>
</mujoco>
